<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Name>BookingCardList</Name>
    <ProjectGuid>b8f1d2a4-3c6e-4f0b-9a21-7d5e8c4b1f90</ProjectGuid>
    <OutputPath>$(MSBuildThisFileDirectory)out\controls</OutputPath>
    <PcfBuildMode>production</PcfBuildMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="PowerAppsTargetsPath" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Pcf" Version="1.*" />
  </ItemGroup>

  <!-- Exclude the npm output / dependencies from the project build artifacts. -->
  <ItemGroup>
    <None Remove="**/*.js.map" />
  </ItemGroup>

</Project>
