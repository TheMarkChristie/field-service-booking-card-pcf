  <data name="BookingCardList_Display" xml:space="preserve"><value>Booking Card List</value></data>
  <data name="BookingCardList_Desc" xml:space="preserve"><value>Card list of Bookable Resource Bookings for Field Service mobile.</value></data>

  <data name="Bookings_Display" xml:space="preserve"><value>Bookings</value></data>
  <data name="Bookings_Desc" xml:space="preserve"><value>Bookable Resource Booking view to display (filters which bookings appear).</value></data>

  <data name="Tab1Name_Display" xml:space="preserve"><value>Tab 1 Name (default)</value></data>
  <data name="Tab1Name_Desc" xml:space="preserve"><value>Fallback name for tab 1. Overridden by env var prx3_BookingTab1Name. Defaults to Today.</value></data>
  <data name="Tab2Name_Display" xml:space="preserve"><value>Tab 2 Name (default)</value></data>
  <data name="Tab2Name_Desc" xml:space="preserve"><value>Fallback name for tab 2. Overridden by env var prx3_BookingTab2Name. Defaults to Tomorrow.</value></data>
  <data name="Tab3Name_Display" xml:space="preserve"><value>Tab 3 Name (default)</value></data>
  <data name="Tab3Name_Desc" xml:space="preserve"><value>Fallback name for tab 3. Overridden by env var prx3_BookingTab3Name. Defaults to Complete.</value></data>

  <data name="CustomStatusName_Display" xml:space="preserve"><value>Custom Status Option Name</value></data>
  <data name="CustomStatusName_Desc" xml:space="preserve"><value>Label for an extra option in the Update-status dropdown. Leave blank to hide it.</value></data>
  <data name="CustomBookingStatusId_Display" xml:space="preserve"><value>Custom: Booking Status (GUID)</value></data>
  <data name="CustomBookingStatusId_Desc" xml:space="preserve"><value>Booking Status record GUID to set on the booking when the custom option is chosen.</value></data>
  <data name="CustomWorkOrderSubStatusId_Display" xml:space="preserve"><value>Custom: Work Order Sub-Status (GUID)</value></data>
  <data name="CustomWorkOrderSubStatusId_Desc" xml:space="preserve"><value>Work Order Substatus record GUID to set on the work order when the custom option is chosen.</value></data>

  <data name="ExtraField1_Display" xml:space="preserve"><value>Extra Field 1 (column name)</value></data>
  <data name="ExtraField2_Display" xml:space="preserve"><value>Extra Field 2 (column name)</value></data>
  <data name="ExtraField3_Display" xml:space="preserve"><value>Extra Field 3 (column name)</value></data>
  <data name="ExtraField_Desc" xml:space="preserve"><value>Logical name of a column to show on the card (value only). Prefix with "workorder." for a Work Order field; default is the booking. Blank = not shown. For a lookup, use its "_logicalname_value" form.</value></data>
  <data name="ExtraFieldsTitle_Display" xml:space="preserve"><value>Custom Fields Heading</value></data>
  <data name="ExtraFieldsTitle_Desc" xml:space="preserve"><value>Optional heading shown above the custom field values (Extra Field 1-3). Only appears when at least one value is present. Blank = no heading.</value></data>

  <data name="HeaderField_Display" xml:space="preserve"><value>Header Badge Field</value></data>
  <data name="HeaderField_Desc" xml:space="preserve"><value>A column to show as a badge in the card header (e.g. Work Order job type). Prefix with "workorder." for a Work Order field; default is the booking. Lookups use "_logicalname_value". Blank = off.</value></data>

  <data name="PriorityColours_Display" xml:space="preserve"><value>Priority Colours</value></data>
  <data name="PriorityColours_Desc" xml:space="preserve"><value>Colour the card top border and show a priority pill, by Work Order priority. Format: "Name=#hex" pairs separated by ";" e.g. High=#D13438;Medium=#F7A600;Low=#107C10. Blank = off.</value></data>

