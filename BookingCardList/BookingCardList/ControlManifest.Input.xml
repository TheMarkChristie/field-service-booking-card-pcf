<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="Proximo3.FieldService" constructor="BookingCardList" version="0.0.34"
    display-name-key="BookingCardList_Display" description-key="BookingCardList_Desc"
    control-type="virtual">

    <external-service-usage enabled="false"></external-service-usage>

    <!-- Bound dataset: Bookable Resource Bookings. The view chosen on the subgrid filters
         which bookings appear (used directly in built-in mode; view-mode runs hard-coded
         views by name instead). -->
    <data-set name="bookings" display-name-key="Bookings_Display" description-key="Bookings_Desc">
    </data-set>

    <!-- Tab labels. Tabs in order: Active (started jobs), then tab1/2/3. -->
    <property name="activeTabName" display-name-key="ActiveTabName_Display" description-key="ActiveTabName_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="Active" />
    <!-- How many days back an active (Traveling/In Progress) job still counts. Active jobs older
         than this are ignored: not shown in the Active tab and they don't block opening new jobs.
         Leave blank to show ALL active jobs regardless of age (no limit). -->
    <property name="activeDays" display-name-key="ActiveDays_Display" description-key="ActiveDays_Desc"
      of-type="Whole.None" usage="input" required="false" />
    <property name="tab1Name" display-name-key="Tab1Name_Display" description-key="Tab1Name_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="Today" />
    <property name="tab2Name" display-name-key="Tab2Name_Display" description-key="Tab2Name_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="Tomorrow" />
    <property name="tab3Name" display-name-key="Tab3Name_Display" description-key="Tab3Name_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="Complete" />

    <!-- Optional extra tab: ALL engineers' bookings for the next N days (read-only overview).
         Shown last, after Complete, only when enabled. Online-oriented (the mobile offline
         profile usually only holds the signed-in user's own bookings). -->
    <property name="allJobsTabEnabled" display-name-key="AllJobsTabEnabled_Display" description-key="AllJobsTabEnabled_Desc"
      of-type="Enum" usage="input" required="false" default-value="0">
      <value name="no" display-name-key="AllJobsTabEnabled_No">0</value>
      <value name="yes" display-name-key="AllJobsTabEnabled_Yes">1</value>
    </property>
    <property name="allJobsTabName" display-name-key="AllJobsTabName_Display" description-key="AllJobsTabName_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="All Jobs" />
    <property name="allJobsDays" display-name-key="AllJobsDays_Display" description-key="AllJobsDays_Desc"
      of-type="Whole.None" usage="input" required="false" default-value="7" />

    <!-- The optional custom status option (label + booking status + work order sub-status) is
         configured on the Field Service Settings record (msdyn_fieldservicesetting):
         prx3_customstatuslabel, prx3_custombookingstatus, prx3_customworkordersubstatus.
         It lives there so the GUIDs travel with the environment. -->

    <!-- Up to 3 extra columns to show on each card (value only, no caption). Enter a column
         logical name; prefix with "workorder." for a Work Order field (default is the booking).
         Blank = not shown. For a lookup column use its "_logicalname_value" form. -->
    <property name="extraField1" display-name-key="ExtraField1_Display" description-key="ExtraField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />
    <property name="extraField2" display-name-key="ExtraField2_Display" description-key="ExtraField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />
    <property name="extraField3" display-name-key="ExtraField3_Display" description-key="ExtraField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />

    <!-- Optional single heading shown above the custom field values (applies to all 3).
         Only appears when at least one custom value is present. Blank = no heading. -->
    <property name="extraFieldsTitle" display-name-key="ExtraFieldsTitle_Display" description-key="ExtraFieldsTitle_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />

    <!-- Header badge: a column shown as a badge in the card header (e.g. Work Order job type,
         domestic/commercial). Same prefix syntax as the custom fields: prefix workorder. for a
         Work Order field, otherwise the booking. Lookups use "_logicalname_value". Blank = off. -->
    <property name="headerField" display-name-key="HeaderField_Display" description-key="HeaderField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />

    <!-- Priority colours: colours the card's top border and shows a priority pill in the header,
         based on the Work Order priority (msdyn_priority). Format: "Name=#hex" pairs separated by
         ';' (e.g. High=#D13438;Medium=#F7A600;Low=#107C10). Blank = feature off. -->
    <property name="priorityColours" display-name-key="PriorityColours_Display" description-key="PriorityColours_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />

    <!-- Maps provider for the address deep-link -->
    <property name="mapsProvider" display-name-key="MapsProvider_Display" description-key="MapsProvider_Desc"
      of-type="Enum" usage="input" required="false" default-value="0">
      <value name="google" display-name-key="MapsProvider_Google">0</value>
      <value name="bing" display-name-key="MapsProvider_Bing">1</value>
      <value name="apple" display-name-key="MapsProvider_Apple">2</value>
    </property>

    <!-- Agreement & Asset section at the bottom of each card. Map the Work Order columns the
         selections write to (logical names). The section shows only when its columns are mapped.
         - underAgreementField: Two-Options column for the "Under Agreement" tick.
         - agreementField: lookup to msdyn_agreement; the dropdown lists the customer's agreements.
         - assetField: lookup to msdyn_customerasset (required); the dropdown lists assets for the
           Work Order's functional location, with an option to add a new one.
         - functionalLocationField: the Work Order lookup the assets are filtered by. -->
    <property name="underAgreementField" display-name-key="UnderAgreementField_Display" description-key="UnderAgreementField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" />
    <property name="agreementField" display-name-key="AgreementField_Display" description-key="AgreementField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="msdyn_agreement" />
    <property name="assetField" display-name-key="AssetField_Display" description-key="AssetField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="msdyn_primarycustomerasset" />
    <property name="functionalLocationField" display-name-key="FunctionalLocationField_Display" description-key="FunctionalLocationField_Desc"
      of-type="SingleLine.Text" usage="input" required="false" default-value="msdyn_functionallocation" />

    <resources>
      <code path="index.ts" order="1" />
      <resx path="strings/BookingCardList.1033.resx" version="1.0.0" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
